#!/usr/bin/bash
# the clearpkgcache worker. runs as root, from clearpkgcache.service or the upgrade worker.
set -eu

# keep the two most recent versions of each installed package, and the most recent version of each
# uninstalled package, so a bad update can still be rolled back and a removed package reinstalled.
paccache -rk2
paccache -ruk1

# as the aur-upgrader user, because root deleting inside its home could follow a symlink planted there
/usr/lib/upgrade/as-aur-upgrader rm -rf /var/lib/aur-upgrader/.cache/paru/clone

# may be useful - cleans the folder including hidden files without complaining:
# https://unix.stackexchange.com/questions/77127/rm-rf-all-files-and-all-hidden-files-without-error
#sudo -u aur-upgrader find /var/lib/aur-upgrader/.cache -name . -o -prune -exec rm -rf -- {} +
