#!/usr/bin/bash
# runs one of the upgrade services like a command: starts it, or joins a run that's already going,
# shows its output until the run ends, and exits with its result. the upgrade, autoremove and
# clearpkgcache commands use this, so the work itself only ever runs inside the service, never in the
# caller's session. only for Type=oneshot services without RemainAfterExit: their start lasts the
# whole run, they're activating while it's going, and they can be started again once it's done.
set -euo pipefail
unit=$1

# show the output from the start of the run: the one that's already going, or the one started below.
# the time is taken here, rather than passing "now", which journalctl would only read once it starts.
since=@$(date +%s)
if [[ $(systemctl show -P ActiveState "$unit") == activating ]]; then
    echo "$unit is already running, following it."
    since=$(systemctl show --timestamp=unix -P InactiveExitTimestamp "$unit")
fi
journalctl -f --no-tail -o cat -u "$unit" --since "$since" &
follower=$!
# the last lines can reach the journal just after the run ends, so give them a moment before stopping
trap 'sleep 1; kill $follower 2>/dev/null || true' EXIT
trap 'echo; echo "Stopped following $unit, but it keeps running."; exit 130' INT

# waits for the run to finish, joining one that's already going, and exits with its result.
# ctrl-c only stops this wait, the run carries on in the service.
systemctl start "$unit"
