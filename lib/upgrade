#!/usr/bin/bash
# the upgrade worker. runs as root, only from upgrade.service, so it never sees a user's session.
set -euo pipefail

# the timer's runs wait for mains power and an unmetered connection, but runs started by hand don't.
# NetworkManager's Metered is 1 for yes and 3 for a guessed yes. without NetworkManager, busctl
# fails, which counts as unmetered.
if [[ ${TRIGGER_UNIT-} == upgrade.timer ]]; then
    if ! systemd-ac-power; then
        echo Skipping this scheduled upgrade, since the system is on battery.
        exit
    fi
    metered=$(busctl get-property org.freedesktop.NetworkManager /org/freedesktop/NetworkManager \
        org.freedesktop.NetworkManager Metered 2>/dev/null || true)
    if [[ $metered == 'u '[13] ]]; then
        echo Skipping this scheduled upgrade, since the connection is metered.
        exit
    fi
fi

enabled=$(/usr/lib/upgrade/config)
is_enabled() { grep -qxF "$1" <<<"$enabled"; }

# notes on the run for lib/notices, kept across the hand-off below, so the new worker reports the
# whole run: where pacman.log ended when the run started, pacman's output, and the steps that failed
export UPGRADE_RUN=${UPGRADE_RUN:-$(mktemp -d)}
[[ -e $UPGRADE_RUN/log-position ]] || stat -c '%i %s' "$(pacman-conf LogFile)" >"$UPGRADE_RUN/log-position"
# however the run ends, record what it left for the admin, and tell them
on_exit() {
    local status=$?
    /usr/lib/upgrade/notices after || status=1
    rm -rf "$UPGRADE_RUN"
    exit "$status"
}
trap on_exit EXIT

# a failed step below doesn't stop the ones after it, but still fails the run at the end
failed=false
# says a step failed, and that the run carries on without it
step_failed() {
    echo "$1 failed, continuing with the rest of the upgrade." >&2
    echo "$1" >>"$UPGRADE_RUN/failed"
    failed=true
}

upgrade_flatpak() {
    if is_enabled upgrade_flatpak && command -v flatpak >/dev/null; then
        echo Upgrading flatpak packages.
        flatpak update --noninteractive || step_failed "Upgrading flatpak packages"
    fi
}

# with noconfirm off, a dry run first, so that pacman's questions wait for the admin. like
# checkupdates, it has its own copy of the sync databases, so the real ones stay matched to the
# installed packages. at the end of its input, pacman answers no, so it changes nothing.
if ! is_enabled noconfirm; then
    echo Checking whether pacman has questions for the upgrade.
    dryrun=/var/lib/upgrade/dryrun
    mkdir -p "$dryrun"
    ln -sfn "$(pacman-conf DBPath)/local" "$dryrun/local"
    pacman -Sy --dbpath "$dryrun" --logfile /dev/null >/dev/null
    LANG=C pacman -Su --dbpath "$dryrun" --logfile /dev/null </dev/null >"$UPGRADE_RUN/dryrun.out" 2>&1 || true
fi
/usr/lib/upgrade/notices questions

# until the admin has handled what blocks upgrades, such as unread news, nothing goes through pacman
# and the run fails. flatpak doesn't involve pacman, so it still upgrades.
/usr/lib/upgrade/notices news
if /usr/lib/upgrade/notices blocking; then
    touch "$UPGRADE_RUN/blocked"
    upgrade_flatpak
    touch "$UPGRADE_RUN/finished"
    exit 1
fi

# pacman -Syu, or self-upgrade below, can install a new version of upgrade itself
version=$(pacman -Q upgrade)
echo Upgrading the system with pacman.
# in English, since lib/notices reads its output
LANG=C pacman -Syu --noconfirm 2>&1 | tee -a "$UPGRADE_RUN/pacman.out"

# upgrade updates itself from the AUR even with upgrade_aur off, so its own fixes always arrive
/usr/lib/upgrade/self-upgrade || step_failed "Upgrading upgrade from the AUR"

# this worker keeps running its old copy, so it would drive the new version's files for the rest of
# the run. the new worker starts the run over, and finds the steps so far have nothing left to do.
if [[ $(pacman -Q upgrade) != "$version" ]]; then
    echo Continuing the run with the new version of upgrade.
    exec /usr/lib/upgrade/upgrade
fi

# AUR packages are built as the aur-upgrader user, since makepkg refuses to run as root
if is_enabled upgrade_aur; then
    if command -v yay >/dev/null; then
        echo Upgrading AUR packages with yay.
        /usr/lib/upgrade/as-aur-upgrader yay --removemake -Syu --noconfirm || step_failed "Upgrading AUR packages"
    elif command -v paru >/dev/null; then
        echo Upgrading AUR packages with paru.
        /usr/lib/upgrade/as-aur-upgrader paru --removemake -Syu --noconfirm || step_failed "Upgrading AUR packages"
    else
        echo No AUR helper found, skipping AUR package upgrades.
    fi
fi

upgrade_flatpak

if is_enabled autoremove; then
    /usr/lib/upgrade/autoremove --noconfirm || step_failed Autoremove
fi

# only after a run where nothing failed, so a failed AUR build's files are still there to look at
if is_enabled clean_cache_on_success && ! $failed; then
    /usr/lib/upgrade/clearpkgcache
fi

# a run that stops before here, on an error, is a failure that lib/notices reports differently
touch "$UPGRADE_RUN/finished"
if $failed; then
    exit 1
fi
