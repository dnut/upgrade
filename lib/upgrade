#!/usr/bin/bash
# the upgrade worker. runs as root, only from upgrade.service, so it never sees a user's session.
set -euo pipefail

# /etc/upgrade.toml is optional, and only needs the options that differ from defaults.toml.
# any value but true turns an option off. old upgrade.conf files, moved to upgrade.toml, may quote it.
config=/etc/upgrade.toml
[[ -e $config ]] || config=/dev/null
enabled=$(python -I -c '
import sys, tomllib
options = tomllib.load(open(sys.argv[1], "rb")) | tomllib.load(open(sys.argv[2], "rb"))
[print(name) for name, value in options.items() if value in (True, "true")]
' /usr/lib/upgrade/defaults.toml "$config")
is_enabled() { grep -qxF "$1" <<<"$enabled"; }

echo Upgrading the system with pacman.
pacman -Syu --noconfirm

# AUR packages are built as the aur-upgrader user, since makepkg refuses to run as root
if is_enabled upgrade_aur; then
    if command -v yay >/dev/null; then
        echo Upgrading AUR packages with yay.
        /usr/lib/upgrade/as-aur-upgrader yay --removemake -Syu --noconfirm
    elif command -v paru >/dev/null; then
        echo Upgrading AUR packages with paru.
        /usr/lib/upgrade/as-aur-upgrader paru --removemake -Syu --noconfirm
    else
        echo No AUR helper found, skipping AUR package upgrades.
    fi
fi

if is_enabled upgrade_flatpak && command -v flatpak >/dev/null; then
    echo Upgrading flatpak packages.
    flatpak update --noninteractive
fi

# a failed autoremove doesn't stop the cache from being cleaned, but still fails the run at the end
autoremove_failed=false
if is_enabled autoremove; then
    if ! /usr/lib/upgrade/autoremove --noconfirm; then
        echo Autoremove failed, continuing with the rest of the upgrade. >&2
        autoremove_failed=true
    fi
fi

if is_enabled clean_cache_on_success; then
    /usr/lib/upgrade/clearpkgcache
fi

if $autoremove_failed; then
    exit 1
fi
