#!/usr/bin/python -I
"""Show and acknowledge what upgrade runs left for the admin to read or handle."""

# notices are files in /var/lib/upgrade/notices: a one-line title, then the details. events, named
# run-*, are what one run printed, and acknowledging deletes them. conditions are checked again on
# every run. acknowledging one silences its key while the condition holds, and once it's gone, the
# key is forgotten too, so the condition is new if it comes back.

import argparse
import grp
import hashlib
import os
import pwd
import re
import subprocess
import sys
import time
import tomllib
import urllib.request
from datetime import datetime
from email.utils import parsedate_to_datetime
from pathlib import Path
from xml.etree import ElementTree

STATE = Path("/var/lib/upgrade")
NOTICES = STATE / "notices"
ACKNOWLEDGED = STATE / "acknowledged"
# the time of the last realtime notification, then the notices there were at the last publish
PUBLISHED = STATE / "published"
SUMMARY = STATE / "summary"
MOTD = STATE / "motd"
# the last copy of the Arch Linux news feed
FEED = STATE / "news.xml"


def main():
    # the summary and motd are read by every admin's shell, whoever writes them
    os.umask(0o022)
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    # news, questions, blocking and after are run by the upgrade worker
    commands.add_parser("news", help="refresh the notices of Arch Linux news")
    commands.add_parser("questions", help="refresh the notice of the dry run's questions")
    commands.add_parser("blocking", help="say what blocks upgrades, or exit 1 if nothing does")
    commands.add_parser("after", help="record what the run left, and notify")
    commands.add_parser("status", help="show every notice")
    commands.add_parser("ack", help="show every notice, then acknowledge them. root only.")
    functions = {
        "news": news,
        "questions": questions,
        "blocking": blocking,
        "after": after,
        "status": status,
        "ack": ack,
    }
    functions[parser.parse_args().command]()


# -- Commands ------------------------------------------------------


def news():
    """refreshes the notices of Arch Linux news posts. the feed is fetched at most every 10 minutes,
    so runs started one after another don't get rate limited, and the last copy is used when it
    can't be fetched. on the first run, the posts from before the last full system upgrade count as
    read, since the admin was upgrading by hand until then."""
    try:
        if not FEED.exists() or time.time() - FEED.stat().st_mtime > 10 * 60:
            url = "https://archlinux.org/feeds/news/"
            with urllib.request.urlopen(url, timeout=30) as response:
                feed = response.read()
            ElementTree.fromstring(feed)
            FEED.write_bytes(feed)
    except (OSError, ElementTree.ParseError) as error:
        print(f"Couldn't fetch the Arch Linux news: {error}")
        if not FEED.exists():
            return
    posts = {}
    for item in ElementTree.parse(FEED).findall("channel/item"):
        link, date = item.findtext("link"), parsedate_to_datetime(item.findtext("pubDate"))
        text = f"Arch Linux news: {item.findtext('title')} ({date:%Y-%m-%d})\n\n{link}\n"
        posts["news-" + slug(link.rstrip("/").rsplit("/", 1)[-1])] = date, text

    if not any(key.startswith("news-") for key in acknowledged() | set(notices())):
        log = open(pacman_log(), errors="replace")
        upgrades = [line for line in log if "[PACMAN] starting full system upgrade" in line]
        upgraded = datetime.now().astimezone()
        if upgrades:
            upgraded = datetime.fromisoformat(upgrades[-1][1:].split("]")[0])
        read = {key for key, (date, text) in posts.items() if date < upgraded}
        save_acknowledged(acknowledged() | read)
    refresh("news", {key: text for key, (date, text) in posts.items()})


def questions():
    """refreshes the notice of the questions pacman asked in the run's dry run, if there was one.
    acknowledging the notice has the next run answer them."""
    output = Path(os.environ["UPGRADE_RUN"]) / "dryrun.out"
    asked = asked_in(output.read_text(errors="replace")) if output.exists() else []
    key = "questions-" + hashlib.sha256("\n".join(asked).encode()).hexdigest()[:16]
    text = (
        "pacman has questions for the upgrade, which wait for you since noconfirm is off\n\n"
        + indent(asked)
        + "\nAnswer them yourself with pacman -Syu, or run sudo upgrade ack to have the next run\n"
        + "answer them with their defaults, the capital letter or 1.\n"
    )
    refresh("questions", {key: text} if asked else {})


def blocking():
    """says what blocks upgrades and exits 0, or exits 1 when nothing does"""
    if reasons := blocked_by(config()):
        print("Not upgrading packages, since some of the notices listed at the end need you first.")
    sys.exit(0 if reasons else 1)


def after():
    """records what the run left for the admin, and tells them. the upgrade worker runs this when
    the run ends, however it ends."""
    run = Path(os.environ["UPGRADE_RUN"])
    run_event(run)
    pacnew()
    failures(run)
    # whoever starts a run by hand sees the notices at the end of its output, so only the timer's
    # runs, which nobody is watching, send the realtime notifications
    publish(config(), realtime=os.environ.get("TRIGGER_UNIT") == "upgrade.timer")


def status():
    current = notices()
    for text in current.values():
        print(text)
    if current:
        print("Once these are handled, run sudo upgrade ack.")
    else:
        print("Nothing needs your attention.")


def ack():
    """shows every notice, then acknowledges them, while holding the upgrade lock, so no run adds
    one in between"""
    current = notices()
    for text in current.values():
        print(text)
    keys = acknowledged()
    for key in current:
        if not key.startswith("run-"):
            keys.add(key)
        (NOTICES / key).unlink()
    save_acknowledged(keys)
    publish(config(), realtime=False)
    print(f"Acknowledged {len(current)} notice{'s' * (len(current) != 1)}.")
    if any(key.startswith("questions-") for key in current):
        print("The next run answers pacman's questions with their defaults.")


# ------------------------------------------------------


def config():
    """the options in /etc/upgrade.toml, over their defaults. lib/config checks them at the start of
    every run."""
    options = tomllib.load(open("/usr/lib/upgrade/defaults.toml", "rb"))
    if os.path.exists("/etc/upgrade.toml"):
        options |= tomllib.load(open("/etc/upgrade.toml", "rb"))
    return options


def notices():
    """the outstanding notices, {key: text}, oldest first"""
    paths = sorted(NOTICES.glob("*"), key=lambda path: path.stat().st_mtime)
    return {path.name: path.read_text() for path in paths}


def acknowledged():
    return set(ACKNOWLEDGED.read_text().split()) if ACKNOWLEDGED.exists() else set()


def save_acknowledged(keys):
    ACKNOWLEDGED.write_text("".join(key + "\n" for key in sorted(keys)))


def write(key, text):
    """writes a notice, unless it's acknowledged or already says that"""
    path = NOTICES / key
    if key not in acknowledged() and not (path.exists() and path.read_text() == text):
        NOTICES.mkdir(parents=True, exist_ok=True)
        path.write_text(text)


def refresh(kind, current):
    """makes a kind of condition's notices match current, {key: text}. the ones that are gone lose
    their notice and their acknowledgement."""
    for key, text in current.items():
        write(key, text)
    for path in NOTICES.glob(kind + "-*"):
        if path.name not in current:
            path.unlink()
    keys = acknowledged()
    kept = {key for key in keys if not key.startswith(kind + "-") or key in current}
    if kept != keys:
        save_acknowledged(kept)


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def indent(lines):
    return "".join(f"    {line}\n" for line in lines)


def pacman_log():
    log = subprocess.run(["pacman-conf", "LogFile"], stdout=subprocess.PIPE, text=True)
    return log.stdout.strip()


def blocked_by(options):
    """the titles of the notices that block upgrades: pacman's questions, and news when
    block_on_news is on"""
    return [
        text.split("\n", 1)[0]
        for key, text in notices().items()
        if key.startswith("questions-")
        or key.startswith("news-") and options["block_on_news"] in (True, "true")
    ]


def script_output(run):
    """what install scripts printed during the run, from pacman.log, under the package they're from.
    hooks are left out, since most of what they print, such as mkinitcpio's, is routine."""
    inode, size = map(int, (run / "log-position").read_text().split())
    with open(pacman_log(), "rb") as file:
        # logrotate may have moved or emptied the log since, and then it's all from this run
        stat = os.fstat(file.fileno())
        if stat.st_ino == inode and stat.st_size >= size:
            file.seek(size)
        lines = file.read().decode(errors="replace").splitlines()

    output, package, shown = [], None, None
    for line in lines:
        message = re.sub(r"^\[[^]]*\] ", "", line)
        changed = r"\[ALPM\] (?:installed|upgraded|reinstalled|downgraded|removed) (.*)"
        if match := re.match(changed, message):
            package = match[1]
        elif message.startswith("[ALPM] running '"):
            package = None
        elif message.startswith("[ALPM-SCRIPTLET] ") and package:
            if package != shown:
                output.append(package + ":")
                shown = package
            output.append("    " + message.removeprefix("[ALPM-SCRIPTLET] "))
    return output


def transactions(output):
    """each pacman -Syu in the run's output that went ahead with its transaction, as (what it
    printed before proceeding, what it printed after). what comes before is printed again by every
    run until it's dealt with, such as IgnorePkg's warnings, so only questions are taken from it."""
    for run in re.split(r"^:: Synchronizing package databases\.\.\.$", output, flags=re.M):
        if ":: Proceed with installation? [Y/n]" in run:
            yield run.split(":: Proceed with installation? [Y/n]", 1)


def asked_in(text):
    """pacman's questions, other than whether to proceed. at the end of its input, pacman carries on
    in the same line, so each question is cut at its answer's prompt."""
    found = re.findall(r"::.*?\[(?:Y/n|y/N)\]|:: There are \d+ providers available for .*?:", text)
    return [question for question in found if "Proceed with" not in question]


def run_event(run):
    """a notice of what the run printed for the admin to read, if anything"""
    out = run / "pacman.out"
    output = out.read_text(errors="replace") if out.exists() else ""
    asked, optional, warned = [], [], []
    for before, after in transactions(output):
        asked += asked_in(before)
        optional += re.findall(r"^New optional dependencies for .*\n(?:[ \t]+.*\n)*", after, re.M)
        warned += [
            line
            for line in after.splitlines()
            # pacnew and pacsave files have their own notices
            if line.startswith(("warning:", "error:")) and not re.search(r"\.pac(new|save)$", line)
        ]

    sections = []
    if scripts := script_output(run):
        sections.append("Install scripts printed:\n" + indent(scripts))
    if asked:
        answered = "pacman answered these itself, with the default, the capital letter or 1:\n"
        sections.append(answered + indent(asked))
    if optional:
        sections.append("".join(optional))
    if warned:
        sections.append("pacman warned:\n" + indent(warned))
    if sections:
        title = f"The upgrade at {time.strftime('%Y-%m-%d %H:%M')} printed something to read"
        write(f"run-{time.strftime('%Y%m%d%H%M%S')}", title + "\n\n" + "\n".join(sections))


def pacnew():
    """refreshes the notices of pacnew, pacsave and pacorig files. a new file with other contents is
    a new notice, even if the old one was acknowledged."""
    pacdiff = subprocess.run(["pacdiff", "-o"], stdout=subprocess.PIPE, text=True)
    paths = pacdiff.stdout.splitlines()
    refresh(
        "pacnew",
        {
            "pacnew-"
            + hashlib.sha256(path.encode() + Path(path).read_bytes()).hexdigest()[
                :16
            ]: f"{path} is waiting to be merged or deleted\n"
            for path in paths
        },
    )


def failures(run):
    """refreshes the notices of failed steps. a run that ended early adds one, and one that finished
    keeps only those that failed this time. a blocked run skipped most steps, so it changes
    nothing."""
    if (run / "blocked").exists():
        return
    now = time.strftime("%Y-%m-%d %H:%M")
    invocation = f"_SYSTEMD_INVOCATION_ID={os.environ.get('INVOCATION_ID', '')}"
    journal = subprocess.run(
        ["journalctl", invocation, "-o", "cat", "-n", "20"], stdout=subprocess.PIPE, text=True
    )
    details = "\nThe end of its log, see journalctl -u upgrade for all of it:\n"
    details += indent(journal.stdout.splitlines())
    if not (run / "finished").exists():
        write("failed-run", f"The upgrade at {now} stopped with an error\n" + details)
    else:
        steps = (run / "failed").read_text().splitlines() if (run / "failed").exists() else []
        refresh(
            "failed",
            {
                f"failed-{slug(step)}": f"{step} failed in the upgrade at {now}\n" + details
                for step in steps
            },
        )


def publish(options, realtime=True):
    """writes the summary for shells and the motd, and when a notice is new, sends the realtime
    notifications"""
    current = notices()
    titles = [text.split("\n", 1)[0] for text in current.values()]
    blocked = blocked_by(options)
    count = "1 notice needs" if len(current) == 1 else f"{len(current)} notices need"
    headline = f"upgrade: {'upgrades are blocked, and ' * bool(blocked)}{count} your attention"
    line = headline + ", see `upgrade status`.\n"
    lines = headline + ":\n" + indent(titles)
    lines += "See them with upgrade status, and once they're handled, run sudo upgrade ack.\n"
    for channel, path, text in [("shell", SUMMARY, line), ("motd", MOTD, lines)]:
        if current and channel in options["notifications"]:
            path.write_text(text)
        else:
            path.unlink(missing_ok=True)

    published = PUBLISHED.read_text().split() if PUBLISHED.exists() else ["0"]
    sent = float(published[0])
    new = set(current) - set(published[1:])
    # while upgrades are blocked, a reminder once a day, since security updates are piling up
    if realtime and (new or blocked and time.time() - sent > 24 * 60 * 60):
        if "wall" in options["notifications"]:
            subprocess.run(["wall", line])
        if "desktop" in options["notifications"]:
            desktop(headline, indent(titles))
        sent = time.time()
    PUBLISHED.write_text(f"{sent}\n" + "".join(key + "\n" for key in current))
    if current:
        print(lines, end="")


def desktop(title, body):
    """a desktop notification for each admin with a session bus: root, and members of wheel and
    upgraders. as each of them, like as-aur-upgrader does for builds. errors, such as no desktop or
    no notify-send, are ignored."""
    for uid in map(int, os.listdir("/run/user")):
        user = pwd.getpwuid(uid)
        groups = {grp.getgrgid(gid).gr_name for gid in os.getgrouplist(user.pw_name, user.pw_gid)}
        if uid == 0 or groups & {"wheel", "upgraders"}:
            as_user = ["setpriv", f"--reuid={uid}", f"--regid={user.pw_gid}", "--init-groups"]
            bus = f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus"
            notify = ["notify-send", "--app-name=upgrade", title, body]
            subprocess.run(
                ["timeout", "10", *as_user, "env", bus, *notify],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )


if __name__ == "__main__":
    main()
