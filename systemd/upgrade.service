[Unit]
Description=Execute a system upgrade.

[Service]
Type=oneshot
Environment=PATH=/usr/bin
# the upgrade command shows the run's output from the journal, and journald's default limit of 10000
# lines per 30 seconds drops some of a big build's. LogRateLimitIntervalSec=0 would mean journald's
# default rather than no limit, so the burst is set higher than any run's output.
LogRateLimitBurst=1000000
# shutdown is blocked while packages are changing, but not while waiting for the lock
ExecStart=/usr/lib/upgrade/locked /usr/bin/systemd-inhibit --what=shutdown --mode=block "--why=Upgrading packages" /usr/lib/upgrade/upgrade
