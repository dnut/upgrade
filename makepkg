#!/usr/bin/bash

# builds the package from this checkout, including uncommitted changes, instead of the github release
# the PKGBUILD names, and puts it in dist/. takes makepkg's options, for example ./makepkg -si to also
# install it. the build itself happens in a temporary folder that's removed afterwards.

set -euo pipefail

cd "$(dirname "$0")"
source PKGBUILD
build=$(mktemp -d)
trap 'rm -rf "$build"' EXIT
# the source makepkg would download is a link to this checkout instead
mkdir -p "$build/$pkgname/src"
ln -s "$PWD" "$build/$pkgname/src/$pkgname-$pkgver"

BUILDDIR=$build PKGDEST=$PWD/dist LOGDEST=$build makepkg --noextract --force "$@"
